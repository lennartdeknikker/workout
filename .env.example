# --- Database ---
# Postgres connection string (better-auth + app share this one connection).
DATABASE_URL=postgres://trainmate:trainmate@localhost:5544/trainmate

# --- better-auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-please-0000000000000000
# Public origin of the app (used for cookies / redirects).
BETTER_AUTH_URL=http://localhost:5173

# --- Public (exposed to the browser) ---
PUBLIC_APP_URL=http://localhost:5173

# --- ExerciseDB proxy ---
EXERCISEDB_BASE_URL=https://oss.exercisedb.dev/api/v1

# --- Production (adapter-node behind a reverse proxy / tunnel) ---
# Public origin; required so SvelteKit accepts form POSTs (CSRF). Set to your real https URL.
# ORIGIN=https://trainmate.example.com
# Trust the proxy's forwarded headers so the app sees the real scheme/host/client IP:
#   Cloudflare Tunnel → ADDRESS_HEADER=cf-connecting-ip
#   Caddy/Nginx       → PROTOCOL_HEADER=x-forwarded-proto, HOST_HEADER=x-forwarded-host, ADDRESS_HEADER=x-forwarded-for, XFF_DEPTH=1
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=cf-connecting-ip

# --- Cloudflare Tunnel (only for the `tunnel` compose profile) ---
# TUNNEL_TOKEN=<token from the Cloudflare Zero Trust dashboard>

# --- Postgres backups (scripts/backup.sh) ---
# BACKUP_DIR=/mnt/backups/trainmate
